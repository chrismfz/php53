diff -apruN php-5.3.29.orig/ext/wddx/tests/bug72750.phpt php-5.3.29/ext/wddx/tests/bug72750.phpt
--- php-5.3.29.orig/ext/wddx/tests/bug72750.phpt	1969-12-31 19:00:00.000000000 -0500
+++ php-5.3.29/ext/wddx/tests/bug72750.phpt	2016-08-25 05:47:33.510298764 -0400
@@ -0,0 +1,34 @@
+--TEST--
+Bug #72750: wddx_deserialize null dereference
+--SKIPIF--
+<?php
+if (!extension_loaded('wddx')) {
+    die('skip. wddx not available');
+}
+?>
+--FILE--
+<?php
+
+$xml = <<< XML
+<?xml version='1.0'?>
+<!DOCTYPE wddxPacket SYSTEM 'wddx_0100.dtd'>
+<wddxPacket version='1.0'>
+<header/>
+        <data>
+                <struct>
+                     <var name='aBinary'>
+                         <binary length='11'>\\tYmluYXJRhdGE=</binary>
+                     </var>
+                 </struct>
+        </data>
+</wddxPacket>
+XML;
+
+$array = wddx_deserialize($xml);
+var_dump($array);
+?>
+--EXPECT--
+array(1) {
+  ["aBinary"]=>
+  string(0) ""
+}
